# VaayuEdge Environment Configuration

# Server Settings
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "https://vaayuedge.neuralmasteryai.com"]

# Processing Mode: "local" (on-device only) or "remote" (hosted server inference)
PROCESSING_MODE=local

# ASR (Speech-to-Text) Adapter: "mock", "whisper_cpp", "faster_whisper"
ASR_ADAPTER=mock
WHISPER_MODEL_SIZE=tiny.en
WHISPER_CPP_BINARY_PATH=/usr/local/bin/whisper-cli
WHISPER_CPP_MODEL_PATH=./models/ggml-tiny.en.bin

# Translation Adapter: "mock", "indictrans2"
TRANSLATION_ADAPTER=mock
INDICTRANS2_MODEL_PATH=./models/indictrans2-en-indic-1B
INDICTRANS2_DEVICE=cpu

# TTS Adapter: "mock", "telugu_tts"
TTS_ADAPTER=mock
TTS_MODEL_PATH=./models/tts_telugu

# Storage & Upload limits
MAX_AUDIO_FILE_SIZE_BYTES=26214400 # 25 MB
MAX_AUDIO_DURATION_SECONDS=180
TEMP_DIR=/tmp/vaayuedge
